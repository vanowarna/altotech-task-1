# Copy to .env and adjust for your environment (dev/prod).
# docker compose reads this automatically.

# --- Environment ---
ENV=dev                      # dev | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING

# --- Neo4j (Brick graph) ---
NEO4J_PASSWORD=altotech123

# --- TimescaleDB (time-series) ---
TS_DB=afdd
TS_USER=afdd
TS_PASSWORD=afdd123

# --- AFDD engine ---
EVAL_INTERVAL_SECONDS=15     # how often rules are evaluated (fast demo preset; use 60 for realism)
ALERT_CHANNELS=log           # comma list: log,webhook
ALERT_WEBHOOK_URL=           # set when ALERT_CHANNELS includes 'webhook'

# --- Production notes ---
# For prod: set strong NEO4J_PASSWORD / TS_PASSWORD, LOG_LEVEL=INFO,
# point ALERT_WEBHOOK_URL at your incident system, and front the API with TLS.
